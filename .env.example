DJANGO_SECRET_KEY=gantikan-dengan-kunci-rahsia-yang-panjang
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=nama-aplikasi.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://nama-aplikasi.onrender.com

# Render akan mengisi DATABASE_URL secara automatik daripada PostgreSQL.
DATABASE_URL=postgresql://pengguna:katalaluan@host:5432/nama_database

# Masukkan koordinat sebenar sekolah
SCHOOL_LATITUDE=5.745697
SCHOOL_LONGITUDE=117.173844
SCHOOL_RADIUS_METERS=50
